<Project Sdk="Microsoft.NET.Sdk">
    <Sdk Name="SlangDxcBundle.Toolchain" />

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    </PropertyGroup>

    <!-- A project mid-migration carries both; the guard must stay silent and nothing may import twice. -->
    <ItemGroup>
        <PackageReference Include="SlangDxcBundle.Toolchain" Version="[$(ToolchainPackageVersion)]" />
    </ItemGroup>

    <Target Name="ValidateToolchainProperties" BeforeTargets="CoreCompile">
        <Error Text="Expected build-host platform $(ExpectedSlangPlatform), got $(SlangDxcToolchainPlatform)."
               Condition="'$(ExpectedSlangPlatform)' != '' And '$(ExpectedSlangPlatform)' != '$(SlangDxcToolchainPlatform)'" />
    </Target>

</Project>
