<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <EnableDefaultItems>false</EnableDefaultItems>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <IsPackable>true</IsPackable>
        <PackageId>SlangDxcBundle.Toolchain.ConsumerTest.Dependency</PackageId>
        <PackageVersion>1.0.0</PackageVersion>
        <Authors>stanoddly</Authors>
        <Description>Local-only package for testing transitive Slang/DXC toolchain build assets.</Description>
        <NoPackageAnalysis>true</NoPackageAnalysis>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SlangDxcBundle.Toolchain"
                          Version="[$(ToolchainPackageVersion)]" />
    </ItemGroup>

</Project>
